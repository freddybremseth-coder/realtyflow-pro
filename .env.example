# RealtyFlow Pro uses the shared Supabase project as master.
# Do not use the old free project ref: jvcdkclfcaccogmvvkrs.

NEXT_PUBLIC_SUPABASE_URL=https://ereapsfcsqtdmzosgnnn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Olivia / Dona Anna data lives in the same Supabase project under olivia.
# Set OLIVIA_SUPABASE_URL/KEY only if Olivia moves to a separate project.
OLIVIA_SCHEMA=olivia
# OLIVIA_SUPABASE_URL=https://ereapsfcsqtdmzosgnnn.supabase.co
# OLIVIA_SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Family data lives in the same Supabase project under family.
FAMILY_SCHEMA=family
# FAMILY_SUPABASE_URL=https://ereapsfcsqtdmzosgnnn.supabase.co
# FAMILY_SUPABASE_KEY=your-supabase-service-role-or-anon-key

REALTYFLOW_SESSION_SECRET=choose-a-long-random-secret

# Lead Intelligence stays disabled until each phase is reviewed and activated server-side.
REALTYFLOW_LEAD_INTELLIGENCE_ENABLED=false
REALTYFLOW_LEAD_INTELLIGENCE_PERSISTENCE_ENABLED=false
REALTYFLOW_LEAD_CONTACT_LOOKUP_HMAC_SECRET=replace-with-long-server-only-random-secret
# Required in production for Lead Intelligence persistence routes.
# Dev/test may use existing server-only DB URL fallbacks.
# Do not expose this to the browser.
# REALTYFLOW_LEAD_INTELLIGENCE_DATABASE_URL=postgresql://...
REALTYFLOW_PROPERTY_MATCHING_ENABLED=false
REALTYFLOW_AUTO_SEND_ENABLED=false

# Social Intelligence / AI Personal Brand
# Uses the existing server-side Supabase service role key above and the shared AI
# client fallback order when ANTHROPIC_API_KEY, GEMINI_API_KEY or OPENAI_API_KEY
# is configured. No LinkedIn scraping or browser-side service keys are used.
REALTYFLOW_SOCIAL_ORGANIZATION_ID=realtyflow

# ─── OpenAI Voice Studio ─────────────────────────────────────────────────
# Server-side only. Enables text-to-speech in AI Media Studio.
# Never expose this as NEXT_PUBLIC_*.
# OPENAI_API_KEY=your-openai-api-key
# Optional model override. Default: gpt-4o-mini-tts
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ─── OpenArt (openart.ai) ────────────────────────────────────────────────
# No API key needed — the integration uses OpenArt's MCP server with OAuth:
# connect via "Koble til OpenArt" in the app (Bilde Studio / Content Hub /
# Ad Campaigns / Neural Beat). Requires OAUTH_ENCRYPTION_KEY (already used
# by the social OAuth flows) and the migration 20260713180000_openart_integration.sql.
# Optional model overrides:
# OPENART_IMAGE_MODEL=nano-banana-2
# OPENART_VIDEO_MODEL=pixverseV6

# ─── DemoSites underdomener (bedrift.chatgenius.pro) ─────────────────────
# Automatisk provisjonering ved publisering. Uten disse brukes
# /sites/<slug>-adressen som fallback.
# VERCEL_TOKEN=            # Vercel → Account Settings → Tokens
# HOSTINGER_API_TOKEN=     # hpanel.hostinger.com → API
# DEMOSITES_ROOT_DOMAIN=chatgenius.pro
# DEMOSITES_SITES_BASE_URL=https://realtyflow.chatgenius.pro